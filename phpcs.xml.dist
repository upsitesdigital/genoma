<?xml version="1.0"?>
<!--
  PHPCS com o WordPress Coding Standards — SÓ as regras que acham falha real
  (segurança, SQL, i18n). As de formatação/nomes do WordPress-Core ficam de fora: o
  framework segue PSR (4 espaços, camelCase, tipos estritos) e elas só gerariam ruído.
  Rodar: npm run lint:wpcs   (ou composer wpcs) — precisa de `composer install` uma vez.
-->
<ruleset name="UpWork">
  <description>Regras de segurança e i18n do WordPress para o tema UpWork.</description>

  <file>.</file>
  <exclude-pattern>/vendor/*</exclude-pattern>
  <exclude-pattern>/node_modules/*</exclude-pattern>
  <exclude-pattern>/assets/*</exclude-pattern>
  <exclude-pattern>/dist/*</exclude-pattern>
  <exclude-pattern>/upsites/core/acf/*</exclude-pattern>
  <exclude-pattern>/upsites/core/cli/*</exclude-pattern>
  <exclude-pattern>/upsites/core/tests/*</exclude-pattern>
  <!-- ferramentas de desenvolvimento (scripts da migração), fora do tema empacotado -->
  <exclude-pattern>/.claude/*</exclude-pattern>
  <!-- saída do npm run fidelity e scripts de teste temporários (.fidelity/ está no .gitignore) -->
  <exclude-pattern>/.fidelity/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <config name="minimum_wp_version" value="6.5"/>
  <config name="testVersion" value="8.1-"/>

  <!-- saída sem escape, nonce, entrada sem sanitizar -->
  <rule ref="WordPress.Security"/>
  <!-- helpers de markup do tema (upsites/core/Support/helpers.php) e o da Interactivity API já devolvem escapado -->
  <rule ref="WordPress.Security.EscapeOutput">
    <properties>
      <property name="customAutoEscapedFunctions" type="array">
        <element value="fw_cn"/>
        <element value="fw_attrs"/>
        <element value="fw_img"/>
        <element value="fw_lines"/>
        <element value="wp_interactivity_data_wp_context"/>
      </property>
    </properties>
  </rule>
  <!-- SQL sem prepare -->
  <rule ref="WordPress.DB.PreparedSQL"/>
  <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
  <!-- extract(), funções perigosas -->
  <rule ref="WordPress.PHP.DontExtract"/>
  <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
    <properties>
      <property name="exclude" type="array">
        <element value="urlencode"/>
        <element value="obfuscation"/>
      </property>
    </properties>
  </rule>
  <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
  <rule ref="WordPress.WP.AlternativeFunctions">
    <!-- leitura de arquivo local do tema (SVG, manifest) com file_get_contents é intencional -->
    <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
    <exclude name="WordPress.WP.AlternativeFunctions.json_encode_json_encode"/>
  </rule>
  <!-- i18n: text domain do tema -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="upsites"/>
      </property>
    </properties>
  </rule>
</ruleset>
